--- !u!114 &2008545407
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2008545403}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "// TPickAndPlace reward function - pick up cube and place in drop zone\r\n//
    Extract observations\r\nfloat gripperDistanceToCube = observations[\"GripperDistanceToCube\"];\r\nfloat
    targetDistanceToCube = observations[\"TargetDistanceToCube\"];\r\nfloat distanceToDropZone
    = observations[\"DistanceToDropZone\"];\r\nfloat gripperOpen = observations[\"GripperOpen\"];\r\nfloat
    isGrasping = observations[\"IsGrasping\"];\r\n\r\n// Extract context\r\nfloat
    previousDistanceToCube = (float)context[\"previousDistanceToCube\"];\r\nfloat
    previousTargetDistanceToCube = (float)context[\"previousTargetDistanceToCube\"];\r\nfloat
    previousDistanceToDropZone = (float)context[\"previousDistanceToDropZone\"];\r\nfloat
    dropZoneThreshold = (float)context[\"dropZoneThreshold\"];\r\nint episodeSteps
    = (int)context[\"episodeSteps\"];\r\nbool isSuccess = (bool)context[\"isSuccess\"];\r\nfloat
    cubeLiftHeight = (float)context[\"cubeLiftHeight\"];\r\n\r\n// Phase 1: Approach
    cube (before grasping)\r\nif (isGrasping == 0f)\r\n{\r\n    // Reward for moving
    IK target closer to cube\r\n    if (episodeSteps > 1)\r\n    {\r\n        float
    distanceDelta = previousTargetDistanceToCube - targetDistanceToCube;\r\n       
    rewards[\"MovingToCube\"] = distanceDelta * 25f;\r\n    }\r\n}\r\n\r\n// Phase
    2: Grasping and lifting\r\nif (isGrasping == 1f)\r\n{\r\n    // Continuous reward
    for maintaining grasp\r\n    rewards[\"GraspingReward\"] = 0.15f;\r\n\r\n   
    // Progressive lift reward - encourage lifting higher\r\n    if (cubeLiftHeight
    > 0.01f)\r\n    {\r\n        rewards[\"LiftReward\"] = Mathf.Min(cubeLiftHeight
    * 3f, 0.4f);\r\n    }\r\n\r\n    // Reward for moving cube toward drop zone (main
    transport incentive)\r\n    if (episodeSteps > 1)\r\n    {\r\n        float dropZoneDelta
    = previousDistanceToDropZone - distanceToDropZone;\r\n        rewards[\"MovingToDropZone\"]
    = dropZoneDelta * 150f;\r\n    }\r\n\r\n    // Bonus for being close to drop
    zone while grasping (ready to release)\r\n    if (distanceToDropZone < dropZoneThreshold
    * 2f)\r\n    {\r\n        rewards[\"NearDropZone\"] = 0.3f;\r\n    }\r\n}\r\n\r\n//
    Phase 3: Successful placement\r\nif (isSuccess)\r\n{\r\n    rewards[\"SuccessfulPlacement\"]
    = 1000.0f;\r\n}\r\n\r\n// Small time penalty\r\nrewards[\"TimePenalty\"] = -0.005f;\r\n\r\n//
    Note: 'rewards' dictionary and total calculation are auto-generated\r\n// Note:
    RewardResult return is auto-generated\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
