--- !u!114 &604578591
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 604578588}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cd1ed74a113b3574597feff2983d9cce, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  rewardFunctionFile: {fileID: 4900000, guid: f41e5140694dc444c85f133cc4ddfe06, type: 3}
  defaultRewardFunctionCode: "// TPickUp reward function - pick up cube and hold
    at y=1.5 for 3 seconds\r\n// Improved with scaled rewards and safety clamping\r\n\r\n//
    Extract observations\r\nfloat distanceToCube = observations[\"DistanceToCube\"];\r\nfloat
    cubeHeight = observations[\"CubeHeight\"];\r\nfloat heightDifference = observations[\"HeightDifference\"];\r\nfloat
    isAtTargetHeight = observations[\"IsAtTargetHeight\"];\r\nfloat holdProgress
    = observations[\"HoldProgress\"];\r\nfloat gripperOpen = observations[\"GripperOpen\"];\r\nfloat
    cubeGrasped = observations[\"CubeGrasped\"];\r\n\r\n// Extract context\r\nfloat
    previousDistanceToCube = (float)context[\"previousDistanceToCube\"];\r\nfloat
    graspThreshold = (float)context[\"graspThreshold\"];\r\nfloat targetHeight =
    (float)context[\"targetHeight\"];\r\nbool isSuccess = (bool)context[\"isSuccess\"];\r\n\r\n//
    Phase 1: Approach and grasp cube (before cube is grasped)\r\nif (cubeGrasped
    == 0f)\r\n{\r\n    // Reward for moving closer to cube - with clamping to prevent
    outliers\r\n    float distanceDelta = previousDistanceToCube - distanceToCube;\r\n   
    float clampedDelta = Mathf.Clamp(distanceDelta, -0.1f, 0.1f); // Clamp to reasonable
    range\r\n    rewards[\"ApproachCube\"] = clampedDelta * 10f; // Reduced from
    100x to 10x\r\n\r\n    // Proximity bonus - stronger as we get closer\r\n   
    if (distanceToCube < graspThreshold * 2f)\r\n    {\r\n        rewards[\"NearCube\"]
    = (1f - distanceToCube / (graspThreshold * 2f)) * 0.2f; // Reduced from 0.5 to
    0.2\r\n    }\r\n\r\n    // Encourage closing gripper when very close to cube\r\n   
    if (distanceToCube < graspThreshold * 1.2f && gripperOpen == 0f)\r\n    {\r\n       
    rewards[\"GripperReadyToGrasp\"] = 0.5f; // Reduced from 1.0 to 0.5\r\n    }\r\n}\r\n//
    Phase 2: Cube grasped - lift to target height and hold\r\nelse\r\n{\r\n    //
    Reward for lifting cube toward target height\r\n    float heightProgress = Mathf.Clamp01(cubeHeight
    / targetHeight);\r\n    rewards[\"LiftingCube\"] = heightProgress * 1.0f; //
    Reduced from 2.0 to 1.0\r\n\r\n    // Strong reward for being at target height\r\n   
    if (isAtTargetHeight > 0.5f)\r\n    {\r\n        rewards[\"AtTargetHeight\"]
    = 2.0f; // Reduced from 5.0 to 2.0\r\n\r\n        // Progressive reward for holding
    (increases with time held)\r\n        rewards[\"HoldingAtHeight\"] = holdProgress
    * 5.0f; // Reduced from 15.0 to 5.0\r\n\r\n        // Bonus reward as we approach
    completion (exponential)\r\n        if (holdProgress > 0.5f)\r\n        {\r\n           
    rewards[\"HoldProgressBonus\"] = Mathf.Pow(holdProgress, 2) * 3.0f; // Reduced
    from 8.0 to 3.0\r\n        }\r\n    }\r\n    else\r\n    {\r\n        // Small
    penalty for being away from target height - with clamping\r\n        float clampedHeightError
    = Mathf.Clamp(heightDifference, 0f, 2.0f);\r\n        rewards[\"HeightError\"]
    = -clampedHeightError * 0.1f; // Reduced from 0.3 to 0.1\r\n    }\r\n\r\n   
    // Encourage keeping gripper closed while holding\r\n    if (gripperOpen == 0f)\r\n   
    {\r\n        rewards[\"GripperClosed\"] = 0.05f; // Reduced from 0.1 to 0.05\r\n   
    }\r\n}\r\n\r\n// Success bonus - large reward for completing the task\r\nif (isSuccess)\r\n{\r\n   
    rewards[\"TaskComplete\"] = 50.0f; // Reduced from 100.0 to 50.0\r\n}\r\n\r\n//
    Small time penalty to encourage efficiency\r\nrewards[\"TimePenalty\"] = -0.0005f;
    // Reduced from -0.001 to -0.0005\r\n\r\n// Note: 'rewards' dictionary and total
    calculation are auto-generated\r\n// Note: RewardResult return is auto-generated\r\n"
  useInspectorReward: 1
  enableRuntimeRecompilation: 1
  createDisplayUI: 1
